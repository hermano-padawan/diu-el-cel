---
import { withBase } from "../utils/paths";

const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="footer-main">
    <div class="footer-about">
      <a class="footer-brand" href={withBase("/")}>Diu el Cel</a>
      <p>Horòscop i astrologia en català per observar els cicles, conèixer els signes i obrir noves preguntes.</p>
      <p class="footer-disclaimer">Contingut cultural, divulgatiu i d'entreteniment. Les interpretacions astrològiques són orientatives i no substitueixen l'assessorament professional.</p>
    </div>

    <nav class="footer-column" aria-label="Explora Diu el Cel">
      <h2>Explora</h2>
      <a href={withBase("/")}>Horòscop d'avui</a>
      <a href={withBase("/compatibilitats/")}>Compatibilitats</a>
      <a href={withBase("/recursos/")}>Recursos d'astrologia</a>
      <a href={withBase("/recursos/glossari/")}>Glossari astrològic</a>
      <a href={withBase("/recursos/preguntes-frequents/")}>Preguntes freqüents</a>
      <a href={withBase("/contacte/")}>Contacte</a>
    </nav>

    <nav class="footer-column" aria-label="Informació legal">
      <h2>Informació legal</h2>
      <a href={withBase("/avis-legal/")}>Avís legal</a>
      <a href={withBase("/privacitat/")}>Política de privacitat</a>
      <a href={withBase("/cookies/")}>Política de cookies</a>
      <a href={withBase("/condicions-us/")}>Condicions d'ús</a>
      <a href={withBase("/contacte/")}>Contacte legal</a>
    </nav>
  </div>

  <div class="footer-bottom">
    <p>© {year} Diu el Cel. Tots els drets reservats.</p>
    <p>Fet sota el cel de Catalunya <span aria-hidden="true">✦</span></p>
  </div>
</footer>
