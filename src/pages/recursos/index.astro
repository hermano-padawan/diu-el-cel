---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { withBase } from "../../utils/paths";

---
<Layout title="Recursos d'astrologia interactius | Diu el Cel" description="Eines i recursos d'astrologia en català: quizzes, calculadores, calendari zodiacal, glossari i més." canonicalPath="/recursos/">
  <Header inner backHref="/" backLabel="Horòscop" />
  <main>
    <section class="resources-hero">
      <div><p class="sign-kicker">Explora i descobreix</p>
        <h1>Recursos d'astrologia</h1>
        <p>Eines interactives per conèixer millor els signes, explorar afinitats i entendre els conceptes bàsics de l'astrologia d'una manera clara i entretinguda.</p>
      </div>
      <img class="section-illustration" src={withBase("/img/decoracio/recursos.webp")} alt="Llibre astrològic obert amb una brúixola" width="420" height="420" decoding="async" />
    </section>

    <section class="resource-featured" aria-labelledby="quiz-resource-title">
      <img class="resource-featured-image" src={withBase("/img/recursos/quiz.webp")} alt="Màscara simbòlica dels quatre elements" width="360" height="360" loading="lazy" decoding="async" />
      <div>
        <p class="sign-kicker">Quiz interactiu</p>
        <h2 id="quiz-resource-title">Quin signe ets realment?</h2>
        <p>Respon unes quantes preguntes sobre la teva manera d'actuar, relacionar-te i prendre decisions. El resultat revela quin arquetip zodiacal encaixa més amb les teves respostes.</p>
        <a class="resource-button" href={withBase("/recursos/quin-signe-ets-realment/")}>Comença el quiz <span aria-hidden="true">→</span></a>
      </div>
    </section>

    <section class="available-resources" aria-labelledby="available-resources-title">
      <p class="sign-kicker">També disponible</p>
      <h2 id="available-resources-title">Recursos disponibles</h2>
      <a class="resource-card" href={withBase("/recursos/calculadora-ascendent/")}>
        <img class="resource-card-image" src={withBase("/img/recursos/ascendent.webp")} alt="" width="360" height="360" loading="lazy" decoding="async" /><div><h3>Calculadora d'ascendent</h3><p>Introdueix la data, l'hora i el lloc de naixement per descobrir el teu signe ascendent.</p></div><span class="resource-card-arrow" aria-hidden="true">→</span>
      </a>
      <a class="resource-card" href={withBase("/recursos/calculadora-signe/")}>
        <img class="resource-card-image" src={withBase("/img/recursos/signe.webp")} alt="" width="360" height="360" loading="lazy" decoding="async" />
        <div><h3>Calculadora del signe</h3><p>Introdueix el dia i el mes de naixement i descobreix el teu signe, element, modalitat i planeta regent.</p></div>
        <span class="resource-card-arrow" aria-hidden="true">→</span>
      </a>
      <a class="resource-card" href={withBase("/recursos/calculadora-compatibilitat/")}>
        <img class="resource-card-image" src={withBase("/img/recursos/compatibilitat.webp")} alt="" width="360" height="360" loading="lazy" decoding="async" />
        <div><h3>Calculadora de compatibilitat</h3><p>Selecciona dos signes i accedeix directament a l'anàlisi completa de la seva compatibilitat zodiacal.</p></div>
        <span class="resource-card-arrow" aria-hidden="true">→</span>
      </a>
      <a class="resource-card" href={withBase("/recursos/calendari-zodiacal/")}>
        <img class="resource-card-image" src={withBase("/img/recursos/calendari.webp")} alt="" width="360" height="360" loading="lazy" decoding="async" />
        <div><h3>Calendari zodiacal</h3><p>Recorre els dotze mesos i consulta les dates, l'element i el planeta regent de cada signe.</p></div>
        <span class="resource-card-arrow" aria-hidden="true">→</span>
      </a>
      <a class="resource-card" href={withBase("/recursos/roda-zodiacal/")}>
        <img class="resource-card-image" src={withBase("/img/recursos/roda.webp")} alt="" width="360" height="360" loading="lazy" decoding="async" />
        <div><h3>Roda zodiacal</h3><p>Explora els dotze signes en una roda interactiva i descobreix-ne les qualitats principals.</p></div>
        <span class="resource-card-arrow" aria-hidden="true">→</span>
      </a>
      <a class="resource-card" href={withBase("/recursos/comparador-signes/")}>
        <img class="resource-card-image" src={withBase("/img/recursos/comparador.webp")} alt="" width="360" height="360" loading="lazy" decoding="async" />
        <div><h3>Comparador de signes</h3><p>Compara dos signes costat per costat i consulta trets, fortaleses, reptes i compatibilitat.</p></div>
        <span class="resource-card-arrow" aria-hidden="true">→</span>
      </a>
      <a class="resource-card" href={withBase("/recursos/glossari/")}>
        <img class="resource-card-image" src={withBase("/img/recursos/glossari.webp")} alt="" width="360" height="360" loading="lazy" decoding="async" />
        <div><h3>Glossari astrològic</h3><p>Consulta definicions clares, exemples i conceptes relacionats per entendre millor l'astrologia.</p></div>
        <span class="resource-card-arrow" aria-hidden="true">→</span>
      </a>
      <a class="resource-card" href={withBase("/recursos/preguntes-frequents/")}>
        <img class="resource-card-image" src={withBase("/img/recursos/faq.webp")} alt="" width="360" height="360" loading="lazy" decoding="async" />
        <div><h3>Preguntes freqüents</h3><p>Resol els dubtes més habituals sobre signes, horòscops, compatibilitat i carta astral.</p></div>
        <span class="resource-card-arrow" aria-hidden="true">→</span>
      </a>
    </section>

  </main>
  <Footer />
</Layout>
